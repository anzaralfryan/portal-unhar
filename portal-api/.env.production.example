# ============================================================
# TEMPLATE .env UNTUK PRODUKSI (Dewaweb / hosting manapun)
# ============================================================
# JANGAN upload file ini apa adanya ke server.
# Copy isi file ini → paste ke .env di server via SSH/File Manager →
# lalu ganti semua nilai <GANTI_...> dengan nilai asli.
# File .env TIDAK BOLEH masuk Git (sudah di-ignore lewat .gitignore).
# ============================================================

APP_NAME="Portal Kampus"
APP_ENV=production
APP_KEY=
# ^ JANGAN isi manual. Setelah upload, jalankan di SSH:
#   php artisan key:generate
APP_DEBUG=false
# ^ WAJIB false di produksi. Kalau true, error Laravel (termasuk query DB,
#   path server, dsb) akan tampil ke publik — celah keamanan serius.

# Samakan dengan domain/subdomain Laravel API kamu di Dewaweb.
# Contoh kalau pakai arsitektur single-origin (Laravel serve React build):
APP_URL=https://domainkamu.com
# Contoh kalau pakai subdomain terpisah untuk API:
# APP_URL=https://api.domainkamu.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<GANTI_nama_database_dari_cPanel>
DB_USERNAME=<GANTI_user_database_dari_cPanel>
DB_PASSWORD=<GANTI_password_database>

JWT_SECRET=
# ^ Generate baru khusus untuk produksi (JANGAN pakai punya lokal).
#   Jalankan di SSH: php artisan jwt:secret
#   (atau generate string acak panjang sendiri, minimal 32 karakter)

# Samakan dengan domain frontend produksi.
# Kalau single-origin (Laravel serve React build), isi sama dengan APP_URL.
FRONTEND_URL=https://domainkamu.com

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# VAPID keys untuk Web Push — pakai yang SAMA dengan yang sudah dipasang
# di frontend (jangan generate ulang, nanti subscription lama jadi invalid).
VAPID_PUBLIC_KEY=<GANTI_sama_seperti_lokal>
VAPID_PRIVATE_KEY=<GANTI_sama_seperti_lokal>
VAPID_SUBJECT=mailto:admin@unhar.ac.id

LOG_CHANNEL=stack
LOG_LEVEL=error
